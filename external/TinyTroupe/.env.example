# Define the OpenAI API key here if you want to use a local .env file for that.
OPENAI_API_KEY=....

# Or the Azure OpenAI API details. 
# To use Entra ID authentication, don't set the API key.
AZURE_OPENAI_API_KEY=....
AZURE_OPENAI_ENDPOINT=....

# The API key for the Helmholtz Blablador API.
# This is optional. If not provided, a dummy key will be used.
HELMHOLTZ_BLABLADOR_API_KEY=
